[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.ini]
indent_size = 4

[*.{sh,bash,zsh,csh,ksh,fish}]
indent_style = space
indent_size = 4

[*.{ps1,psm1,psd1,ps1xml,psc1,pssc,psrc,bat,cmd}]
indent_style = space
indent_size = 4

[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

